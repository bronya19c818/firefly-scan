APP_NAME=JuZiScan API
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=18001
LOG_LEVEL=INFO

SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# SQLite3 (Default for quickstart, no DB server required)
DATABASE_URL=sqlite:///./juziscan.db
# PostgreSQL (Optional for production)
# DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/juziscan

BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-this-admin-password
BOOTSTRAP_ADMIN_NICKNAME=JuZiScan Admin

ALIPAY_APP_ID=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_NOTIFY_URL=https://api.example.com/api/v1/payments/alipay/notify
ALIPAY_APP_PRIVATE_KEY=
ALIPAY_ALIPAY_PUBLIC_KEY=
ALIPAY_SELLER_ID=

TENCENT_SMS_APP_ID=
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
TENCENT_SMS_REGION=ap-guangzhou
TENCENT_SMS_TEMPLATE_PARAMS={code}
TENCENT_SMS_DEBUG_MODE=True
SMS_CODE_EXPIRE_MINUTES=5
SMS_CODE_RESEND_INTERVAL_SECONDS=60
SMS_CODE_MAX_ATTEMPTS=5

# User avatars are stored on the local server filesystem.
AVATAR_STORAGE_DIR=storage/avatars
AVATAR_MAX_BYTES=5242880
